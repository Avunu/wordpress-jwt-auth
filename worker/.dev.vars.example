# Local-dev config bundle for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# The SIGNING_KEY PEM must be a single line with literal \n between the base64 lines.
ISSUER="http://localhost:8787"
FROM_EMAIL="login@example.com"
FROM_NAME="Dev Sign-in"
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# The fleet. A real deployment passes this to createAuthWorker() as bundled JSON instead; the
# TENANTS var is the env-driven equivalent, handy for `wrangler dev`. Two entries here so the
# cross-site SSO confirmation has somewhere to send you.
TENANTS='[{"clientId":"local","displayName":"Local Site","redirectUris":["http://localhost:8080/?jwt_auth_callback=1"]},{"clientId":"local2","displayName":"Second Local Site","redirectUris":["http://localhost:8081/?jwt_auth_callback=1"]}]'

# How long an SSO session survives, in days. Defaults: 14 rolling / 90 absolute.
# SESSION_IDLE_DAYS="14"
# SESSION_ABSOLUTE_DAYS="90"

# Pre-fleet single-tenant deployments describe their one site with these instead of TENANTS.
# Still supported, so an existing per-site Worker keeps working on this version unchanged.
# CLIENT_ID="wordpress"
# ALLOWED_REDIRECT_URIS=["http://localhost:8080/?jwt_auth_callback=1"]
