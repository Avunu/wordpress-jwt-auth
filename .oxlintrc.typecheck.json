{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Type-aware lint pass (`npm run lint:typecheck`), kept separate from .oxlintrc.json:
	// --type-aware activates every type-aware rule in enabled categories, so categories are all off
	// here and we opt IN. rolldown.config.ts and vitest.config.ts are covered too: tsconfig.json
	// references tsconfig.node.json, which puts them in a program the type-aware pass can resolve.
	"categories": {
		"correctness": "off",
		"nursery": "off",
		"pedantic": "off",
		"perf": "off",
		"restriction": "off",
		"style": "off",
		"suspicious": "off"
	},
	"ignorePatterns": ["build", "node_modules", "tests/playground", "vendor", "worker", "**/*.map"],
	"plugins": ["typescript"],
	"rules": {
		"typescript/no-floating-promises": "error",
		"typescript/await-thenable": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-argument": "error"
	}
}
