{
    "name": "wordpress/jwt-auth",
    "description": "OIDC / proxy JWT authentication for WordPress, configured via wp-config.php",
    "type": "wordpress-plugin",
    "version": "3.0.0",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "firebase/php-jwt": "^7.1",
        "yahnis-elsts/plugin-update-checker": "^5.6"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^11.0",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpunit/phpunit": "^12",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "replace": {
        "phpstan/phpstan": "*"
    },
    "autoload": {
        "psr-4": {
            "JwtAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JwtAuth\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "check": [
            "@phpstan",
            "@test"
        ]
    }
}
